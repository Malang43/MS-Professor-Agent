# Development frontend only: copy to apps/web/.env.local when overriding localhost.
NEXT_PUBLIC_API_URL=http://localhost:8787
# Production always uses same-origin /api; NEXT_PUBLIC_API_URL is ignored there.
# Set the public workers.dev destination in apps/web/vercel.json.
# Worker local values belong in ignored apps/api/.dev.vars, not frontend env files:
# APP_ORIGIN=http://localhost:3000
# OAUTH_ENABLED=false
# LIVE_EMAIL_ENABLED=false
# AI_PROVIDER=mock
# GROQ_FREE_PLAN_CONFIRMED=false
# Optional backend secrets, only after manual setup and separate authorization:
# TOKEN_ENCRYPTION_KEY=<base64-of-32-random-bytes>
# GMAIL_CLIENT_ID=<google-web-client-id>
# GMAIL_CLIENT_SECRET=<google-client-secret>
# OUTLOOK_CLIENT_ID=<microsoft-application-client-id>
# OUTLOOK_CLIENT_SECRET=<microsoft-client-secret>
# GROQ_API_KEY=<free-plan-groq-key>
# GROQ_MODEL=<currently-supported-free-plan-model>
# LIVE_TEST_RECIPIENTS=<explicitly-authorized-controlled-email-addresses>
# Never put keys, passwords, tokens or real documents in Git or NEXT_PUBLIC_ values.
# No card, trial, R2 subscription, purchased domain or paid upgrade is permitted.
# See the single manual setup checklist in DEPLOYMENT.md.

# Optional temporary server-only OAuth start allowance (15/day vs normal 5).
# Resolve existing administrator account UUIDs server-side; never use email/profile input.
# OAUTH_ADMIN_TEST_USER_IDS=<designated-existing-account-uuid>
# Until explicitly removed; global 50/day and all existing counters are unchanged.

# Optional transactional ACCOUNT emails only (never Gmail outreach). Owner setup required.
# MAIL_PROVIDER=brevo
# MAIL_DELIVERY_ENABLED=false
# MAIL_FREE_PLAN_CONFIRMED=false
# MAIL_SENDER_VERIFIED=false # true only after sender verification and owner inbox certification
# MAIL_FROM=<verified-transactional-sender-address>
# BREVO_API_KEY=<backend-only-api-key>

# Server-only owner and simulation controls. Live activation is deployed separately.
# LIVE_OWNER_USER_IDS=
# MOCK_DELIVERY_ENABLED=false
